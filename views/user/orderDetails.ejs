<%- include('../partials/user/header') %>

<div class="container py-5">

  <div class="card shadow p-4">

    <h5 class="fw-bold mb-4">
      Order #<%= order.orderId %>
    </h5>

    <!-- STATUS STEPS -->
    <div class="d-flex justify-content-between text-center mb-4">

      <% const statuses = ['Processing', 'Shipped', 'Delivered','Cancelled']; %>
      <% statuses.forEach(status => { %>
        <div>
          <div class="rounded-circle <%= 
            statuses.indexOf(order.status) >= statuses.indexOf(status) ? 'bg-success' : 'bg-secondary' 
          %>"
          style="width:20px;height:20px;margin:auto;"></div>
          <small><%= status.toUpperCase() %></small>
        </div>
      <% }) %>

    </div>

    <!-- PRODUCT DETAILS -->
    <h6 class="fw-bold">Product Details</h6>

   <% orderItems.forEach(item => { %>
  <div class="border rounded p-3 mb-3 d-flex align-items-center">
    <div style="width:80px; height:80px; overflow:hidden; margin-right:15px;">
      <% if(item.image){ %>
        <img src="<%= item.image %>" alt="<%= item.product_name %>" style="width:100%; height:100%; object-fit:cover;">
      <% } else { %>
        <img src="/images/default-product.png" alt="Product" style="width:100%; height:100%; object-fit:cover;">
      <% } %>
    </div>
    <div>
      <h6><%= item.product_name %></h6>
      <p class="mb-1">Qty: <%= item.quantity %> | ₹<%= item.price %></p>
       <% const isCancelled = order.cancelledProducts.some(
  p => p.orderItem_id.toString() === item._id.toString()
); %>

<% if(isCancelled){ %>
  <span class="badge bg-danger">Cancelled</span>
<% } else { %>
  <span class="badge bg-warning"><%= order.status %></span>
<% } %>
    </div>
  </div>
<% }) %>

    <!-- SHIPPING ADDRESS -->
    <div class="border rounded p-3 mb-3">
      <h6 class="fw-bold">Shipping Address</h6>
      <p class="mb-1"><%= order.delivery_address.name %></p>
      <p class="mb-1"><%= order.delivery_address.house_name %></p>
      <p class="mb-1"><%= order.delivery_address.locality %></p>
      <p class="mb-1"><%= order.delivery_address.city %></p>
      <p class="mb-1"><%= order.delivery_address.state %></p>
      <p class="mb-1">Pin: <%= order.delivery_address.pincode %></p>
      <p>Ph: <%= order.delivery_address.mobilenumber %></p>
    </div>

    <!-- ORDER SUMMARY -->
    <div class="border rounded p-3 d-flex justify-content-between align-items-center">
      <div>
        <h6 class="fw-bold">Order Summary</h6>
        <div class="d-flex justify-content-between">
          <span>Total Amount</span>
          <span>₹<%= order.total_price %></span>
        </div>
        <div class="mt-2">
          <strong>Status:</strong> 
          <span class="badge bg-success"><%= order.status %></span>
        </div>
      </div>
      <div>
        <a href="/invoice/<%= order._id %>" class="btn btn-primary">View Invoice</a>
      </div>
   
    </div>
   <div class="mt-3  text-center">
  <a href="/orders" class="btn btn-secondary">
    ← Go Back
  </a>
  </div> 
  
</div>
</div>

<%- include('../partials/user/footer') %>