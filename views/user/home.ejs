
<%-include("../../views/partials/user/header")%>
   <!-- Banner Carousel Start -->
<section id="bannerCarousel">
  <div id="homeBanner" class="carousel slide" data-bs-ride="carousel"  data-bs-interval="3000" >
    
    <!-- Indicators -->
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#homeBanner" data-bs-slide-to="0" class="active" aria-current="true"></button>
      <button type="button" data-bs-target="#homeBanner" data-bs-slide-to="1"></button>
      <button type="button" data-bs-target="#homeBanner" data-bs-slide-to="2"></button>
    </div>

    <!-- Carousel Items -->
    <div class="carousel-inner">
      <!-- Slide 1 -->
      <div class="carousel-item active">
        <img src="/img/bannerclogs.webp" class="d-block w-100" alt="Banner 1">
        <div class="carousel-caption d-none d-md-block">
    
          <a href="/shop" class="btn btn-primary">Shop Now</a>
        </div>
      </div>

      <!-- Slide 2 -->
      <div class="carousel-item">
        <img src="/img/banner.webp" class="d-block w-100" alt="Banner 2">
        <div class="carousel-caption d-none d-md-block">
      
          <a href="/shop" class="btn btn-primary">Shop Now</a>
        </div>
      </div>

      <!-- Slide 3 -->
      <div class="carousel-item">
        <img src="/img/banner1.webp" class="d-block w-100" alt="Banner 3">
        <div class="carousel-caption d-none d-md-block">
      
          <a href="/shop" class="btn btn-primary">Shop Now</a>
        </div>
      </div>
    </div>

    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#homeBanner" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#homeBanner" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>

  </div>
</section>
<!-- Banner Carousel End -->

<section class="top-categories py-5 bg-light">
  <div class="container">
    <!-- Heading -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="fw-bold mb-0">Top Categories</h2>
      <a href="/shop" class="text-dark fw-bold">See More &raquo;</a>
    </div>

    <div class="row g-4">
      <% const topCategories = [
        { name: "Sports", image: "/img/sports.jpg", link: "/shop?category=Sports" },
        { name: "Clogs", image: "/img/clogs.webp", link: "/shop?category=Clogs" },
        { name: "Slippers/Flip-Flops", image: "/img/slippers.webp", link: "/shop?category=Slippers/Flip-Flops" }
      ]; %>

      <% topCategories.forEach(category => { %>
        <div class="col-lg-4 col-md-6 col-sm-12 d-flex">
          <div class="card border-0 shadow-sm w-100 text-center">
            <!-- Clickable Image -->
            <a href="<%= category.link %>">
              <img src="<%= category.image %>" alt="<%= category.name %>" class="card-img-top category-img">
            </a>

            <!-- Category Name -->
            <div class="card-body">
              <h5 class="fw-bold"><%= category.name %></h5>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<style>.top-categories .category-img {
  width: 100%;
  height: 250px;
  object-fit: cover;
  border-radius: 10px;
  cursor: pointer;
  transition: transform 0.3s, box-shadow 0.3s;
}

.top-categories .category-img:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}

.top-categories h5 {
  margin-top: 10px;
}
</style>


<section class="discover-banner py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6">
        <h2 class="fw-bold display-5">Discover Our Latest Collection</h2>
        <p class="text-muted mb-4">Explore the newest trends and find your perfect style today.</p>
        <a href="/shop" class="btn btn-dark btn-lg">Shop Now</a>
      </div>
      <div class="col-md-6">
        <a href="/shop">
          <img src="/img/banner2.webp" alt="Discover Banner" class="img-fluid rounded shadow">
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.discover-banner h2 {
  color: #222;
}
.discover-banner p {
  font-size: 1.1rem;
}
.discover-banner img {
  cursor: pointer;
  transition: transform 0.3s ease;
}
.discover-banner img:hover {
  transform: scale(1.05);
}
</style>






<!--newarrival-->
<section class="new-arrivals py-5">
   <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="fw-bold mb-0">New Arrivals</h2>
      <a href="/shop" class="text-dark fw-bold">See More &raquo;</a>
    </div>
    <div class="row g-4">
      <% newArrivals.forEach(product => { %>
        <div class="col-lg-3 col-md-4 col-sm-6 d-flex">
          <div class="card border-0 shadow-sm w-100 position-relative">
            
            <!-- Wishlist Icon -->
           
              <span class="wishlist-icon position-absolute top-0 end-0 p-2">
                    <i class="fa fa-heart"></i>
                  </span>

               

            <!-- Main Product Image -->
            <img 
              src="<%= product.variants[0]?.images[0] || '/img/placeholder.jpg' %>" 
              class="card-img-top main-image" 
              alt="<%= product.product_name %>"
              data-product-id="<%= product._id %>"
            >

            <div class="card-body text-center">
              <!-- Color Variants -->
              <div class="d-flex justify-content-center mb-3 flex-wrap">
                <% product.variants.forEach((variant, index) => { %>
                  <% if (variant.images && variant.images[0]) { %>
                    <img 
                      src="<%= variant.images[0] %>" 
                      alt="<%= variant.color %>" 
                      class="color-thumb"
                      data-main-image="<%= variant.images[0] %>"
                    >
                  <% } %>
                <% }) %>
              </div>

              <!-- Product Name -->
              <h6 class="fw-bold"><%= product.product_name %></h6>

              <!-- Product Price -->
              <p class="text-muted mb-1">
                ₹<%= product.variants[0]?.discount_price || product.variants[0]?.price %>
              </p>

              <a href="/productDetails/<%= product._id %>" class="btn btn-outline-dark btn-sm mt-2">View Details</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<style>

/* Wishlist Icon */
.wishlist-icon i {
  font-size: 22px;
  color: #ccc; /* Default grey */
  cursor: pointer;
  transition: transform 0.2s, color 0.3s ease;
}

.wishlist-icon i.active {
  color: #ff4d4d; /* Red when active */
  transform: scale(1.2);
}

.wishlist-icon i:hover {
  transform: scale(1.2);
}

/* Color variant thumbnails */
.color-thumb {
  width: 50px;
  height: 50px;
  object-fit: cover;
  border-radius: 5px;
  cursor: pointer;
  border: 2px solid transparent;
  transition: border 0.3s ease;
}
.color-thumb:hover {
  border: 2px solid #000;
}



</style>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 🖼️ Change main image on clicking color variant
    const colorThumbs = document.querySelectorAll(".color-thumb");
    colorThumbs.forEach(thumb => {
      thumb.addEventListener("click", () => {
        const mainImage = thumb.closest(".card").querySelector(".main-image");
        mainImage.src = thumb.dataset.mainImage;
      });
    });

    // ❤️ Wishlist toggle
    const wishlistIcons = document.querySelectorAll(".wishlist-icon i");
    wishlistIcons.forEach(icon => {
      icon.addEventListener("click", e => {
        e.stopPropagation();
        icon.classList.toggle("active");
      });
    });
  });
</script>






<%-include("../../views/partials/user/footer")%>

