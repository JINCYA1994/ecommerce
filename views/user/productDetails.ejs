<%- include("../../views/partials/user/header") %>

<section class="py-5">
  <div class="container">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= product.product_name %></li>
      </ol>
    </nav>

    <div class="row">
      <!-- LEFT SIDE -->
      <div class="col-md-5">
        <div class="main-image mb-3 text-center position-relative">
          <img id="mainImage"
               src="<%= product.variants[0].images[0] %>"
               class="img-fluid border rounded"
               alt="<%= product.product_name %>"
               style="transition: transform 0.2s ease;">
        </div>

        <!-- Thumbnail images (same color variant) -->
        <div id="imageThumbnails" class="d-flex gap-2 justify-content-center">
          <% product.variants[0].images.forEach(image => { %>
            <img src="<%= image %>"
                 class="img-thumbnail"
                 style="width:60px; height:60px; cursor:pointer;"
                 onclick="changeMainImage('<%= image %>')">
          <% }) %>
        </div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="col-md-7">

        <!-- Product Name -->
        <h3 class="fw-bold mb-3"><%= product.product_name %></h3>

        <!-- Price and Discount -->
        <div class="d-flex align-items-center mb-2">
          <h4 class="fw-bold text-success me-3">₹<%= product.variants[0].discount_price %></h4>
          <h5 class="text-muted text-decoration-line-through me-2">₹<%= product.variants[0].price %></h5>
          <span class="badge bg-success">
            <%= Math.round(((product.variants[0].price - product.variants[0].discount_price) / product.variants[0].price) * 100) %>% off
          </span>
        </div>

        <!-- Ratings -->
        <div class="mb-3">
          ⭐⭐⭐⭐☆ <small>(<%= reviews.length %> Customer Reviews)</small>
        </div>

        <!-- Description -->
        <p class="text-muted"><%= product.product_description %></p>

    <!-- SIZE SELECTION + SIZE GUIDE -->
<div class="d-flex align-items-center mb-3">
  <strong class="me-3">Size:</strong>

  <div id="sizeOptions" class="d-flex gap-2 flex-wrap me-3">
    <% product.variants[0].sizes.forEach(sizeObj => { %>
      <% if(!sizeObj.isDeleted && sizeObj.isListed) { %>
        <button class="btn btn-outline-secondary btn-sm size-btn"
                onclick="selectSize('<%= sizeObj.size %>', event)">
          <%= sizeObj.size %>
        </button>
      <% } %>
    <% }) %>
  </div>

  <!-- 🧭 SIZE GUIDE -->
  <div class="d-flex align-items-center" style="cursor:pointer;" data-bs-toggle="modal" data-bs-target="#sizeGuideModal">
    <span class="text-decoration-underline fw-semibold">SIZE GUIDE</span>
   
  </div>
</div>


        <!-- COLOR VARIANTS -->
        <div class="d-flex align-items-center mb-3">
          <strong class="me-3">Color:</strong>
          <div id="colorOptions" class="d-flex gap-2">
            <% product.variants.forEach((variant, index) => { %>
              <img src="<%= variant.images[0] %>"
                   class="img-thumbnail border border-dark-subtle"
                   style="width:60px; height:60px; cursor:pointer;"
                   onclick="changeColorVariant(<%= index %>)"
                   title="<%= variant.color %>">
            <% }) %>
          </div>
        </div>

        <!-- Quantity -->
        <div class="d-flex align-items-center mb-3">
          <strong class="me-3">Quantity:</strong>
          <div class="input-group" style="width:120px;">
            <button class="btn btn-outline-secondary" type="button" onclick="changeQty(-1, event)">-</button>
            <input id="quantity" type="text" class="form-control text-center" value="1">
            <button class="btn btn-outline-secondary" type="button" onclick="changeQty(1, event)">+</button>
          </div>
        </div>

        <!-- Buttons -->
        <div class="mt-4 d-flex gap-3 align-items-center">
          <button class="btn btn-dark px-4">Add To Cart</button>
          <button class="btn btn-danger px-4">Buy Now</button>
         <i id="wishlistIcon" class="fa-regular fa-heart fs-4 text-secondary" style="cursor:pointer;" onclick="toggleWishlist(this)"></i>

        </div>

        <% 
          const totalStock = product.variants[0].sizes.reduce((acc, s) => acc + (s.stock || 0), 0);
        %>
        <% if(totalStock > 0){ %>
          <p class="mt-3 text-success">In Stock: <%= totalStock %></p>
        <% } else { %>
          <p class="mt-3 text-danger fw-bold">Out of Stock</p>
        <% } %>

      </div>
    </div>

    <!-- REVIEWS -->
    <hr class="my-5">
    <h4 class="fw-bold mb-3">Customer Reviews (<%= reviews.length %>)</h4>

    <% if(reviews.length === 0){ %>
      <p class="text-muted">No reviews yet. Be the first to review this product!</p>
    <% } else { %>
      <% reviews.forEach(r => { %>
        <div class="border rounded p-3 mb-3">
          <strong><%= r.name %></strong>
          <span class="text-warning">⭐ <%= r.rating %></span>
          <p class="mb-1"><%= r.comment %></p>
          <small class="text-muted"><%= r.createdAt.toDateString() %></small>
        </div>
      <% }) %>
    <% } %>

    <button class="btn btn-outline-dark mb-3" onclick="toggleReviewForm()">Write a Review</button>

    <!-- Review Form -->
    <form id="reviewForm" action="/product/<%= product._id %>/review" method="POST" class="border p-3 rounded" style="display:none;">
      <div class="mb-3">
        <label class="form-label">Your Name</label>
        <input type="text" name="name" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Rating</label>
        <select name="rating" class="form-select" required>
          <option value="">Select Rating</option>
          <option value="5">⭐⭐⭐⭐⭐</option>
          <option value="4">⭐⭐⭐⭐</option>
          <option value="3">⭐⭐⭐</option>
          <option value="2">⭐⭐</option>
          <option value="1">⭐</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Comment</label>
        <textarea name="comment" class="form-control" rows="3" required></textarea>
      </div>
      <button type="submit" class="btn btn-success">Submit Review</button>
    </form>

    <!--  RELATED PRODUCTS -->
<hr class="my-5">
<h4 class="fw-bold mb-4">Related Products</h4>

<div class="row">
  <% related.forEach(rp => { %>
    <div class="col-md-3 mb-4">
      <div class="card border-0 shadow-sm h-100 position-relative">

        <!-- Clickable Image -->
        <a href="/productDetails/<%= rp._id %>">
          <img 
            src="<%= rp.variants[0]?.images[0] || '/img/placeholder.jpg' %>" 
            class="card-img-top" 
            alt="<%= rp.product_name %>">
        </a>

        <div class="card-body text-center">

          <!-- Product Name -->
          <h6 class="fw-bold"><%= rp.product_name %></h6>

          <!-- Price -->
          <p class="text-success fw-bold mb-2">
            ₹<%= rp.variants[0]?.discount_price || rp.variants[0]?.price %>
          </p>

          <!-- Rating (from Review collection) -->
          <% if (rp.averageRating && rp.averageRating > 0) { %>
            <div class="mb-2">
              <% for (let i = 1; i <= 5; i++) { %>
                <% if (i <= Math.round(rp.averageRating)) { %>
                  <i class="fa fa-star text-warning"></i>
                <% } else { %>
                  <i class="fa fa-star-o text-warning"></i>
                <% } %>
              <% } %>
              <small>(<%= rp.reviewCount || 0 %>)</small>
            </div>
          <% } else { %>
            <div class="mb-2 text-muted small">No reviews yet</div>
          <% } %>

          <!-- Color Thumbnails -->
          <div class="d-flex justify-content-center gap-2 flex-wrap">
            <% rp.variants.forEach(variant => { %>
              <% if (variant.images && variant.images[0]) { %>
                <img 
                  src="<%= variant.images[0] %>" 
                  class="rounded border"
                  style="width:40px;height:40px;cursor:pointer;"
                  title="<%= variant.color %>"
                  onclick="window.location='/productDetails/<%= rp._id %>'">
              <% } %>
            <% }) %>
          </div>

        </div>
      </div>
    </div>
  <% }) %>
</div>

</section>
<!-- 🧩 SIZE GUIDE MODAL -->
<div class="modal fade" id="sizeGuideModal" tabindex="-1" aria-labelledby="sizeGuideLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="sizeGuideLabel">Men’s Size Guide</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="table-responsive">
          <table class="table table-bordered text-center align-middle">
            <thead class="table-secondary">
              <tr>
                <th>Footchic Size / UK</th>
                <th>EU</th>
                <th>CM</th>
                <th>Inches</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>6</td><td>40</td><td>24.2–24.9</td><td>9.5–9.8</td></tr>
              <tr><td>7</td><td>41</td><td>25–25.7</td><td>9.8–10.1</td></tr>
              <tr><td>8</td><td>42</td><td>25.8–26.5</td><td>10.2–10.4</td></tr>
              <tr><td>9</td><td>43</td><td>26.6–27.3</td><td>10.5–10.7</td></tr>
              <tr><td>10</td><td>44/45</td><td>27.4–28.1</td><td>10.8–11.1</td></tr>
              <tr><td>11</td><td>46</td><td>28.2–28.9</td><td>11.1–11.4</td></tr>
              <tr><td>12</td><td>47</td><td>29–29.7</td><td>11.4–11.7</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {

    // Review form toggle
    window.toggleReviewForm = function() {
      const form = document.getElementById('reviewForm');
      form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }

    // Quantity control
    window.changeQty = function(delta, event) {
      event.preventDefault();
      const input = document.getElementById("quantity");
      let qty = parseInt(input.value) || 1;
      qty = Math.max(1, qty + delta);
      input.value = qty;
    }

    // Main image change
    window.changeMainImage = function(src) {
      document.getElementById("mainImage").src = src;
    }

    // Color variant change
    window.changeColorVariant = function(index) {
      const variants = <%- JSON.stringify(product.variants) %>;
      const variant = variants[index];
      document.getElementById("mainImage").src = variant.images[0];

      // Update thumbnails
      const thumbContainer = document.getElementById("imageThumbnails");
      thumbContainer.innerHTML = "";
      variant.images.forEach(img => {
        const thumb = document.createElement("img");
        thumb.src = img;
        thumb.className = "img-thumbnail";
        thumb.style = "width:60px;height:60px;cursor:pointer;";
        thumb.onclick = () => changeMainImage(img);
        thumbContainer.appendChild(thumb);
      });

      // Update size buttons
      const sizeContainer = document.getElementById("sizeOptions");
      sizeContainer.innerHTML = "";
      variant.sizes.forEach(s => {
        if(!s.isDeleted && s.isListed) {
          const btn = document.createElement("button");
          btn.className = "btn btn-outline-secondary btn-sm size-btn";
          btn.textContent = s.size;
          btn.onclick = (event) => selectSize(s.size, event);
          sizeContainer.appendChild(btn);
        }
      });



    }

    // Size select highlight
    window.selectSize = function(size, event) {
      document.querySelectorAll(".size-btn").forEach(btn => btn.classList.remove("btn-dark"));
      event.target.classList.add("btn-dark");
    }

 // Wishlist toggle
window.toggleWishlist = function(icon) {
  icon.classList.toggle("fa-solid");
  icon.classList.toggle("fa-regular");
  icon.classList.toggle("text-danger");
  icon.classList.toggle("text-secondary");
}

    // Zoom effect
    const mainImage = document.getElementById("mainImage");
    mainImage.addEventListener("mousemove", e => {
      const rect = e.target.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      mainImage.style.transformOrigin = `${x}px ${y}px`;
      mainImage.style.transform = "scale(1.5)";
    });
    mainImage.addEventListener("mouseleave", () => {
      mainImage.style.transform = "scale(1)";
    });
  });


  
</script>

<%- include("../../views/partials/user/footer") %>
