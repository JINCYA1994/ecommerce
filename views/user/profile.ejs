<%- include('../../views/partials/user/header') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Profile | FootChic</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- CSS Links -->
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    body {
      background-color: #f5f5f5;
      font-family: 'Poppins', sans-serif;
    }

    /* Breadcrumb
     - pushed further down */
    .breadcrumb {
      background-color: transparent;
      font-size: 15px;
      margin-top: 50px; /* increased from 90px */
      margin-left: 80px; /* slight push right */
    }


    .card-custom {
      background-color: #fff;
      border-radius: 15px;
      padding: 25px 30px;
      box-shadow: 0 3px 8px rgba(0,0,0,0.08);
      border: 1px solid #ddd;
    }

    .card-custom h5 {
      font-weight: 700;
      border-bottom: 2px solid #000;
      padding-bottom: 10px;
      margin-bottom: 20px;
      color: #000;
    }

    .card-custom p {
      margin-bottom: 8px;
      font-size: 15px;
      color: #333;
    }

    /* Buttons */
    .btn-edit, .btn-add {
      background-color: #000;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 8px 20px;
      font-weight: 600;
      transition: 0.3s;
    }

    .btn-edit:hover, .btn-add:hover {
      background-color: #333;
    }

    /* Address box - black border & white bg */
    .address-box {
      border: 1px solid #000;
      background-color: #fff;
      border-radius: 10px;
      padding: 15px 20px;
      margin-bottom: 15px;
    }

    .address-box p {
      margin-bottom: 4px;
      color: #000;
    }

    .alert {
      font-size: 14px;
    }

    @media (max-width: 992px) {
      .profile-container {
        flex-direction: column;
        align-items: center;
        padding-left: 0;
      }

      .profile-sidebar {
        width: 90%;
      }

      .profile-content {
        width: 90%;
      }
    }
  </style>
</head>

<body>
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-dark">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page">Profile</li>
    </ol>
  </nav>

  <!-- Profile Layout -->
  <div class="profile-container">
    
  <%- include('../../views/partials/user/profileSidebar', { 
        userData: userData, 
        activePage: 'profile' 
      }) %>

    <!-- Profile Content -->
    <div class="profile-content">
      <div class="card-custom">
        <h5>Personal Information</h5>
        <p><strong> Name:</strong> <%= userData.username%></p>
         <p><strong>Email:</strong> <%= userData.email %></p>
      
        <button class="btn-edit mt-2" onclick="window.location.href='/edit-profile'">Edit Profile</button>
      </div>

      <div class="card-custom">
        <h5>Saved Addresses</h5>
        <% if (addresses && addresses.length > 0) { %>
          <% addresses.forEach(addr => { %>
            <div class="address-box">
              <p><strong><%= addr.name %></strong></p>
              <p><%= addr.house_name %>, <%= addr.locality %> , <%= addr.city %></p>
              <p><%= addr.state %> - <%= addr.pincode %></p>
              <p><%= addr.mobilenumber %></p>
            </div>
          <% }) %>
        <% } else { %>
          <div class="alert alert-dark">No addresses found. Please add an address.</div>
        <% } %>

        <button class="btn-add mt-2" onclick="window.location.href='/address'">Add New Address</button>
      </div>
    </div>
  </div>

</body>
</html>

<%- include('../../views/partials/user/footer') %>
