<%- include("../../views/partials/admin/header") %>

<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Product Management</h3>
    <a href="/admin/products/add" class="btn btn-primary">+ Add Product</a>
  </div>
        
  <% if (success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Search Form -->
  <form class="d-flex mb-4" method="GET" action="/admin/products">
    <input 
      type="text" 
      name="search" 
      class="form-control me-2" 
      placeholder="Search product..." 
      value="<%= typeof search !== 'undefined' ? search : '' %>"
    />
    <button type="submit" class="btn btn-primary me-2">Search</button>
    <a href="/admin/products" class="btn btn-secondary">Clear</a>
  </form>
</div>

<table class="table table-bordered table-striped align-middle text-center">
  <thead class="table-dark">
    <tr>
      <th>No</th>
      <th>Product Name</th>
      <th>Category</th>
      <th>Variants</th>
     
    </tr>
  </thead>

  <tbody>
    <% if(products && products.length > 0){ %>
      <% products.forEach((product, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= product.product_name %></td>
          <td>
            <%= product.category_id 
                ? (product.category_id.category_name || product.category_id.name) 
                : 'N/A' %>
          </td>

          <!-- Variants Count + View Button -->
          <td>
            <span class="badge bg-info">
              <!-- <%= product.variants.length %> Variants -->
               
<% product.variants.forEach(variant => { %>
  <div>
    Color: <%= variant.color %> —
    Sizes: <%= variant.sizes.length %>
  </div>
<% }) %>

              
            </span>
            <br>
            <button 
              class="btn btn-sm btn-outline-primary mt-1"
              onclick="openVariantModal('<%= product._id %>')">
              View
            </button>
          </td>

        </tr>
      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="5" class="text-muted">No products found</td>
      </tr>
    <% } %>
  </tbody>
</table>



<!-- Pagination -->
<nav aria-label="Page navigation">
  <ul class="pagination justify-content-center">
    <% if(currentPage > 1) { %>
      <li class="page-item">
        <a class="page-link" href="/admin/products?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %>">Previous</a>
      </li>
    <% } %>

    <% for(let i = 1; i <= totalPages; i++) { %>
      <li class="page-item <%= currentPage === i ? 'active' : '' %>">
        <a class="page-link" href="/admin/products?page=<%= i %><%= search ? '&search=' + search : '' %>"><%= i %></a>
      </li>
    <% } %>

    <% if(currentPage < totalPages) { %>
      <li class="page-item">
        <a class="page-link" href="/admin/products?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %>">Next</a>
      </li>
    <% } %>
  </ul>
</nav>
<div class="modal fade" id="variantModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Product Variants</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <table class="table table-bordered text-center">
         <thead class="table-dark">
  <tr>
    <th>Image</th>
    <th>Color</th>
    <th>Price</th>
    <th>Discount</th>
    <th>Size</th>
    <th>Status</th>
    <th>Actions</th>
  </tr>
</thead>
          <tbody id="variantTableBody">
            <!-- JS will insert rows -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
const productsData = <%- JSON.stringify(products) %>;

function openVariantModal(productId) {
  const product = productsData.find(p => p._id === productId);
  const tbody = document.getElementById("variantTableBody");
  tbody.innerHTML = "";

  product.variants.forEach(variant => {
    variant.sizes.forEach(size => {
      if (size.isDeleted) return;

      tbody.innerHTML += `
        <tr>
          <td>
            <img src="${variant.images?.[0] || ''}"
                 style="width:60px;height:60px;object-fit:cover">
          </td>
          <td>${variant.color || 'N/A'}</td>
          <td>₹${variant.price}</td>
          <td>${variant.discount_price || '-'}</td>
          <td>${size.size}</td>
          <td>
            ${size.isListed
              ? '<span class="badge bg-success">Listed</span>'
              : '<span class="badge bg-danger">Unlisted</span>'}
          </td>
          <td>
            <a href="/admin/products/${product._id}/variant/${variant._id}/size/${size._id}/${size.isListed ? 'unlist' : 'list'}"
               class="btn btn-sm btn-secondary mb-1">
               ${size.isListed ? 'Unlist' : 'List'}
            </a>

            <form method="POST"
              action="/admin/products/${product._id}/variant/${variant._id}/size/${size._id}/delete"
              class="d-inline delete-form">
              <button type="submit" class="btn btn-sm btn-danger">
                Delete
              </button>
            </form>
            <a href="/admin/products/${product._id}/variant/${variant._id}/size/${size._id}/edit"
   class="btn btn-sm btn-warning">
   Edit
</a>

          </td>
        </tr>
      `;
    });
  });

  const modal = new bootstrap.Modal(
    document.getElementById("variantModal")
  );
  modal.show();
}

/* SweetAlert delete confirmation */
document.addEventListener("submit", function (e) {
  if (e.target.classList.contains("delete-form")) {
    e.preventDefault();

    Swal.fire({
      title: "Are you sure?",
      text: "You won't be able to revert this!",
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      cancelButtonColor: "#3085d6",
      confirmButtonText: "Yes, delete it!"
    }).then(result => {
      if (result.isConfirmed) {
        e.target.submit();
      }
    });
  }
});
</script>


<%- include("../../views/partials/admin/footer") %>

